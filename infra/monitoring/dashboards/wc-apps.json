      "targets": [
        {
          "refId": "A",
          "expr": "sum by (k8s_deployment_name) (kube_deployment_status_replicas_available{k8s_namespace=~\"$namespace\"})",
          "legendFormat": "{{k8s_deployment_name}} available",
          "datasource": {
            "type": "prometheus",
            "uid": "a35af9d3-363d-4b66-b426-d15344c2e1a8"
          }
        },
        {
          "refId": "B",
          "expr": "sum by (k8s_deployment_name) (kube_deployment_spec_replicas{k8s_namespace=~\"$namespace\"})",
          "legendFormat": "{{k8s_deployment_name}} desired",
          "datasource": {
            "type": "prometheus",
            "uid": "a35af9d3-363d-4b66-b426-d15344c2e1a8"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
