    {
      "id": 8,
      "type": "timeseries",
      "title": "Deployment replicas available vs desired",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "a35af9d3-363d-4b66-b426-d15344c2e1a8"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 5
