{
  "uid": "wc-storage",
  "title": "Storage health",
  "description": "ZFS pool, vdev and scrub health plus per-disk SMART. Source: textfile metrics written on the host (smartmon.prom, zfs_health.prom, zfs_zpool.prom); see docs/zfs-observability.md. ZFS vdev error counters reset on reboot; the SMART counters do not.",
  "tags": [
    "wavecat"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "1m",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "At a glance",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
