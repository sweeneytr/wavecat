        "type": "prometheus",
        "uid": "a35af9d3-363d-4b66-b426-d15344c2e1a8"
      },
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 12,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(time() - max(zfs_pool_scan_last_end_timestamp_seconds{function=\"scrub\"})) / 86400",
          "legendFormat": "",
